#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-only
"""llama.cpp Metal adapter for Let's Infer Engine protocol 2."""

from __future__ import annotations

import json
import os
import pathlib
import subprocess
import sys
from collections.abc import Mapping, Sequence

from native_frontend import (
    AdapterError,
    artifact_path,
    backend_json,
    expand_arguments,
    run,
)


def build_command(runtime: Mapping[str, object], port: int) -> Sequence[str]:
    executable = os.environ.get("LETSINFER_NATIVE_UPSTREAM_EXECUTABLE")
    if not executable:
        raise AdapterError("llama.cpp executable is unavailable")
    return [
        executable,
        "--model",
        artifact_path(runtime, runtime["model"]["artifact"]),  # type: ignore[index]
        "--alias",
        str(runtime["logical_model"]),
        "--host",
        "127.0.0.1",
        "--port",
        str(port),
        *expand_arguments(runtime),
    ]


def count_tokens(host: str, port: int, body: bytes, _model: str) -> int:
    status, value = backend_json(
        host,
        port,
        "POST",
        "/v1/chat/completions/input_tokens",
        body,
    )
    count = value.get("input_tokens")
    if status != 200 or not isinstance(count, int) or isinstance(count, bool) or count <= 0:
        raise AdapterError("llama.cpp exact rendered token count failed")
    return count


def verify_engine() -> None:
    executable = os.environ.get("LETSINFER_NATIVE_UPSTREAM_EXECUTABLE", "")
    path = pathlib.Path(executable)
    if path.is_symlink() or not path.is_file() or not os.access(path, os.X_OK):
        raise AdapterError("llama.cpp executable is unavailable")
    result = subprocess.run(
        [str(path), "--version"],
        check=False,
        capture_output=True,
        text=True,
        timeout=30,
    )
    if result.returncode != 0 or "version" not in (result.stdout + result.stderr).lower():
        raise AdapterError("llama.cpp executable verification failed")


if __name__ == "__main__":
    try:
        raise SystemExit(
            run("llamacpp", build_command, count_tokens, verify_engine=verify_engine)
        )
    except (AdapterError, KeyError, OSError, ValueError, json.JSONDecodeError) as error:
        print(f"engine-adapter: {error}", file=sys.stderr)
        raise SystemExit(1) from error
