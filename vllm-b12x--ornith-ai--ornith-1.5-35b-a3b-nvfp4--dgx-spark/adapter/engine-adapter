"""vLLM/B12X Engine OCI adapter for Let's Infer protocol v2."""

from __future__ import annotations

import json
import pathlib
import sys
from collections.abc import Mapping, Sequence
from typing import Any

_root = pathlib.Path(__file__).resolve().parent
_installed_lib = _root.parent / "lib"
sys.path.insert(0, str(_installed_lib if _installed_lib.is_dir() else _root))

from engine_frontend import AdapterError, artifact_path, backend_json, expand_arguments, run


def _cache_arguments(runtime: Mapping[str, Any]) -> Sequence[str]:
    cache = runtime.get("cache")
    if (
        not isinstance(cache, Mapping)
        or cache.get("provider") != "vllm-b12x-letsinfer-prefix-v1"
        or cache.get("persistent") is not True
        or cache.get("prewarm") is not False
        or cache.get("replay_output_policy") != "restored-repeat-exact"
    ):
        raise AdapterError("vLLM/B12X persistent cache contract is invalid")
    config = cache.get("config")
    required = {
        "durable_capacity_bytes",
        "resident_capacity_bytes",
        "ttl_seconds",
        "min_tokens",
        "max_tokens",
        "direct_reads",
        "native_capacity_bytes",
        "capture_tail_tokens",
        "exact_capsules",
    }
    if not isinstance(config, Mapping) or set(config) != required:
        raise AdapterError("vLLM/B12X persistent cache config is invalid")
    for field in (
        "durable_capacity_bytes",
        "ttl_seconds",
        "min_tokens",
        "max_tokens",
        "capture_tail_tokens",
    ):
        value = config.get(field)
        if not isinstance(value, int) or isinstance(value, bool) or value <= 0:
            raise AdapterError(f"vLLM/B12X cache {field} must be positive")
    for field in ("resident_capacity_bytes", "native_capacity_bytes"):
        value = config.get(field)
        if not isinstance(value, int) or isinstance(value, bool) or value < 0:
            raise AdapterError(f"vLLM/B12X cache {field} must be non-negative")
    if config["resident_capacity_bytes"] != 0:
        raise AdapterError("vLLM/B12X resident cache must be zero on unified memory")
    if config["native_capacity_bytes"] != 0:
        raise AdapterError("vLLM/B12X native cache capacity must be zero")
    if config["direct_reads"] is not True:
        raise AdapterError("vLLM/B12X cache direct reads must be enabled")
    if config["exact_capsules"] is not False:
        raise AdapterError("vLLM/B12X MTP cache capsules must be disabled")
    if config["max_tokens"] < config["min_tokens"]:
        raise AdapterError("vLLM/B12X cache max_tokens must be at least min_tokens")
    transfer = {
        "kv_connector": "LetsInferPrefixConnector",
        "kv_role": "kv_both",
        "kv_connector_module_path": "letsinfer_prefix_connector.connector",
        "kv_connector_extra_config": {
            "store_root": "/root/.cache/letsinfer-prefix-store/vllm-b12x",
            "capacity_bytes": config["durable_capacity_bytes"],
            "resident_capacity_bytes": config["resident_capacity_bytes"],
            "ttl_seconds": config["ttl_seconds"],
            "min_tokens": config["min_tokens"],
            "max_tokens": config["max_tokens"],
            "direct_reads": config["direct_reads"],
            "native_capacity_bytes": config["native_capacity_bytes"],
            "capture_tail_tokens": config["capture_tail_tokens"],
            "exact_capsules": config["exact_capsules"],
            "engine_identity": runtime["engine"]["oci"]["immutable_id"],
            "device_address_mode": "host-copy-no-device-registration-v1",
        },
    }
    return (
        "--kv-transfer-config",
        json.dumps(transfer, sort_keys=True, separators=(",", ":")),
    )


def build_command(runtime: Mapping[str, Any], port: int) -> Sequence[str]:
    return [
        "vllm",
        "serve",
        artifact_path(runtime, runtime["model"]["artifact"]),
        "--served-model-name",
        runtime["logical_model"],
        "--host",
        "127.0.0.1",
        "--port",
        str(port),
        *_cache_arguments(runtime),
        *expand_arguments(runtime),
    ]


def build_environment(_runtime: Mapping[str, Any]) -> Mapping[str, str]:
    return {}


def count_tokens(host: str, port: int, body: bytes, _model: str) -> int:
    status, value = backend_json(host, port, "POST", "/tokenize", body)
    count = value.get("count")
    tokens = value.get("tokens")
    if status != 200 or not isinstance(tokens, list):
        raise AdapterError("vLLM/B12X exact token count failed")
    if (
        not isinstance(count, int)
        or isinstance(count, bool)
        or count <= 0
        or count != len(tokens)
    ):
        raise AdapterError("vLLM/B12X returned an invalid token count")
    return count


if __name__ == "__main__":
    try:
        raise SystemExit(
            run("vllm-b12x", build_command, build_environment, count_tokens)
        )
    except (AdapterError, KeyError, OSError, ValueError) as error:
        print(f"engine-adapter: {error}", file=sys.stderr)
        raise SystemExit(1) from error
