"""Build-time verifier for the embedded MLC Engine protocol identity."""

import argparse
import json


parser = argparse.ArgumentParser()
parser.add_argument("command", choices=("verify",))
parser.add_argument("--protocol", type=int, required=True)
arguments = parser.parse_args()
if arguments.protocol != 2:
    raise SystemExit("unsupported Engine protocol")
print(json.dumps({"engine_protocol": 2, "status": "ok"}, separators=(",", ":")))
